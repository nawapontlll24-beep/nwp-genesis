rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /commands/{commandId} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /documents/{docId} {
      allow read, write: if true;
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
